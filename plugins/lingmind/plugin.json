{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "author": {
    "name": "LingMind",
    "url": "https://lingmind.cn"
  },
  "description": "连接 LingMind，查询项目与业务数据，处理任务、设备与日常工作。",
  "extensions": {
    "com.openai": {
      "apps": "./.app.json",
      "interface": {
        "brandColor": "#1677FF",
        "capabilities": [
          "Interactive",
          "Read",
          "Write"
        ],
        "category": "Business & Operations",
        "composerIcon": "./assets/lingmind-logo.png",
        "defaultPrompt": [
          "Summarize the active incidents in my LingMind project",
          "List the users and roles I am authorized to view in my LingMind project",
          "Generate a wayline and prepare a mission action plan"
        ],
        "developerName": "LingMind",
        "displayName": "LingMind",
        "logo": "./assets/lingmind-logo.png",
        "longDescription": "连接你的 LingMind 工作环境，查看项目、设备、任务和告警，处理业务数据并生成报告。重要操作会在执行前请求确认。",
        "shortDescription": "连接 LingMind 工作环境",
        "websiteURL": "https://lingmind.cn"
      }
    }
  },
  "homepage": "https://lingmind.cn",
  "keywords": [
    "lingmind",
    "iot",
    "operations",
    "mcp"
  ],
  "license": "MIT",
  "name": "lingmind",
  "repository": "https://github.com/lingmind/annex",
  "version": "0.5.1"
}
