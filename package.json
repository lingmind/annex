{
  "name": "lingmind-annex",
  "version": "1.5.3",
  "description": "LingMind Agent installer and DeepSeek Harness bundle",
  "type": "module",
  "main": "scripts/dsh-plugin.mjs",
  "bin": {
    "lingmind-agent": "scripts/agent-cli.mjs"
  },
  "files": [
    "scripts/agent-cli.mjs",
    "scripts/dsh-plugin.mjs",
    "scripts/agent_runtime.py",
    "scripts/agent-oauth.py",
    "scripts/agent_release.py",
    "scripts/setup-agent.py",
    "scripts/configure-workbuddy-lingmind.py",
    "scripts/configure-doubao-lingmind.py",
    "scripts/requirements-agent-oauth.txt",
    "plugins/release.json",
    "plugins/lingmind/skills",
    "plugins/lingmind/references",
    "plugins/lingmind/assets",
    "docs/dsh-quick-start.md",
    "docs/agent-distribution.md",
    "docs/agent-connections.md",
    "cordis.patch.yml",
    "scripts/dsh-operator-plugin.mjs",
    "plugins/lingmind-operator/skills",
    "plugins/lingmind-operator/references",
    "plugins/lingmind-operator/assets",
    "locale",
    "operator-locale"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lingmind/annex.git"
  },
  "homepage": "https://lingmind.cn",
  "author": "LingMind",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/dsh-skill-filesystem": ">=0.2.1-rc.5 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill-filesystem": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "icon": "plugins/lingmind/assets/lingmind-logo-256.png",
  "exports": {
    ".": "./scripts/dsh-plugin.mjs",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*",
    "./scripts/dsh-operator-plugin.mjs": "./scripts/dsh-operator-plugin.mjs",
    "./scripts/dsh-operator-plugin.mjs/locale/*": "./operator-locale/*",
    "./scripts/dsh-operator-plugin.mjs/icon": "./plugins/lingmind-operator/assets/lingmind-logo-256.png"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  }
}
